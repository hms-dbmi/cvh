VITE_CLOUDFRONT_URL=""
# Path under VITE_CLOUDFRONT_URL where this environment's featured.json lives.
# UUIDs differ between DEV and PROD, so each environment points to its own file.
# Example: "dev/featured.json" (DEV), "prod/featured.json" (PROD).
# Leave UNSET locally — the hook falls back to /featured.json (served from
# `frontend/public/featured.json`) in dev so new developers don't need to
# configure anything. Set explicitly to a root-relative or absolute URL to
# override (e.g. "/featured.json" or "https://...").
VITE_FEATURED_PATH=""
VITE_API_URL=""
VITE_CFDB_API_URL=""