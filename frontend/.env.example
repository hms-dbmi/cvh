VITE_AUTH0_DOMAIN=""
VITE_AUTH0_CLIENTID=""
VITE_API_AUDIENCE=""
VITE_CLOUDFRONT_URL=""
# Path under VITE_CLOUDFRONT_URL where this environment's featured.json lives.
# UUIDs differ between DEV and PROD, so each environment points to its own file.
# Example: "featured/dev-featured.json" (DEV), "featured/prod-featured.json" (PROD).
VITE_FEATURED_PATH="featured.json"
VITE_API_URL=""
VITE_CFDB_API_URL=""
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN="<ph_project_token>"
VITE_PUBLIC_POSTHOG_HOST="<ph_client_api_host>"
# Tags every PostHog event with an `environment` super-property so we
# can filter prod vs. non-prod inside a single free-tier project. Also
# gates capture: only "production" (or `VITE_POSTHOG_DEBUG=true` below)
# initializes the SDK. Local dev + auto dev-deploy stay silent.
VITE_ENVIRONMENT="development"
# Escape hatch: flip to "true" on a preview deploy when you want to
# smoke-test PostHog instrumentation without pushing to prod. Leave
# unset otherwise.
VITE_POSTHOG_DEBUG=""
# CFDE-required Google Analytics (gtag.js) Measurement ID. When set,
# vite.config.ts's `inject-google-analytics` plugin adds the standard
# GA snippet to the built HTML. Leave unset for local dev so GA doesn't
# fire on your machine. Dev / prod values live in the deploy workflows.
VITE_GA_MEASUREMENT_ID=""