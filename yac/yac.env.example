# Template for the YAC service's settings (docs/yac.md). The deployment sets
# UDI_BEDROCK, AWS_REGION, AWS_BEDROCK_BASE_URL (the bedrock-runtime endpoint),
# GPT_MODEL_NAME, UDI_QUERY_BACKENDS, YAC_USAGE_TABLE and LANGFUSE_ENVIRONMENT;
# secrets come from Secrets Manager. Never put
# OPENAI_API_KEY or OPENAI_BASE_URL here: udiagent won't start with them
# alongside UDI_BEDROCK.

# --- Sign-in: the YAC API in the environment's Auth0 tenant ---
# Dev values shown; prod uses its own tenant and audience.
JWT_JWKS_URL=https://<auth0-domain>/.well-known/jwks.json
JWT_ISSUER=https://<auth0-domain>/
JWT_AUDIENCE=<YAC API identifier>
# Auth0 signs with RS256; udiagent's default (HS256) won't start with a JWKS URL.
JWT_ALGORITHM=RS256

# --- Browsers allowed to call YAC ---
UDI_CORS_ORIGINS=https://dev.visualizationhub.org

# --- Model tuning for gpt-6.1-sol (from Nick) ---
UDI_OPENAI_API=responses
UDI_REASONING_EFFORT=low
UDI_TEMPERATURE=omit
UDI_MAX_COMPLETION_TOKENS=16384
UDI_VIS_TOOL_CHOICE=required

# --- Monthly budgets (yac/cvh_yac.py) ---
# A person's limit is raised with `yac_monthly_usd` in their Auth0 app_metadata.
YAC_USER_MONTHLY_USD=2
YAC_TOTAL_MONTHLY_USD=100

# Langfuse's host and keys come from Secrets Manager together: udiagent
# refuses to start with only some of the three.
